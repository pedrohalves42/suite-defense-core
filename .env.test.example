# =====================================================
# E2E Test Environment Variables
# =====================================================
# Copy to .env.test.local for real test credentials

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-test-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ==============================================
# TEST USERS (Use UUIDs, not real credentials)
# ==============================================
TEST_SUPER_ADMIN_EMAIL=super@cybershield.test
TEST_SUPER_ADMIN_PASSWORD=YOUR_TEST_PASSWORD_HERE
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=YOUR_TEST_PASSWORD_HERE
TEST_OPERATOR_EMAIL=operator@test.com
TEST_OPERATOR_PASSWORD=YOUR_TEST_PASSWORD_HERE
TEST_VIEWER_EMAIL=viewer@test.com
TEST_VIEWER_PASSWORD=YOUR_TEST_PASSWORD_HERE

# ==============================================
# TEST TENANTS
# ==============================================
TEST_TENANT_A_ID=a0000000-0000-0000-0000-000000000001
TEST_TENANT_A_SLUG=test-tenant-a
TEST_TENANT_B_ID=b0000000-0000-0000-0000-000000000002
TEST_TENANT_B_SLUG=test-tenant-b

# ==============================================
# TEST CONFIGURATION
# ==============================================
TEST_BASE_URL=http://localhost:8080
PLAYWRIGHT_TIMEOUT=30000