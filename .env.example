# =====================================================
# Cloudflare Turnstile
# =====================================================
# Get these from: https://dash.cloudflare.com/
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# =====================================================
# Application Configuration
# =====================================================
NODE_ENV=development
VITE_API_URL=http://localhost:3000
