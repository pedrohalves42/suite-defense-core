# =============================================================================
# Golden Test: Multi-Tenant Isolation Test Configuration
# =============================================================================
# Copy this file to .env.test and fill in the values for your test environment
#
# IMPORTANT: These must be real test users in separate tenants to validate
# RLS isolation. Do NOT use production credentials.
# =============================================================================

# Supabase connection (usually already in .env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Tenant A test user credentials
TEST_TENANT_A_EMAIL=tenant-a@test.local
TEST_TENANT_A_PASSWORD=secure-test-password-a
TEST_TENANT_A_ID=00000000-0000-0000-0000-000000000001

# Tenant B test user credentials (different tenant!)
TEST_TENANT_B_EMAIL=tenant-b@test.local
TEST_TENANT_B_PASSWORD=secure-test-password-b
TEST_TENANT_B_ID=00000000-0000-0000-0000-000000000002

# =============================================================================
# Setup Instructions:
# 1. Create two test tenants in your database
# 2. Create a user for each tenant
# 3. Add some test data (e.g., agents) for each tenant
# 4. Fill in the values above
# 5. Run: npx playwright test golden-test-tenant-isolation
# =============================================================================
